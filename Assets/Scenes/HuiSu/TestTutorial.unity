    - target: {fileID: 7234795183544438997, guid: d785354abee38f84795a0a3d4724df3d, type: 3}
      propertyPath: m_text
      value: "\uB4DC\uB514\uC5B4 \uB808\uC77C\uC744 \uB9CC\uB4E4 \uC2DC\uAC04\uC785\uB2C8\uB2E4!\r\n\n\uC7AC\uB8CC\uB97C
        \uC190\uC5D0 \uB4E4\uACE0 \uC788\uB294 \uC0C1\uD0DC\uC5D0\uC11C, \r\n\uC5F4\uCC28\uC758
        \uC138\uBC88\uC9F8 \uCE78\uC778 \"\uD654\uBB3C\uCE78\"\uC5D0 \uB123\uC5B4\uC8FC\uC138\uC694.\r\n\r\n\uB808\uC77C
        \uC81C\uC791\uC5D0\uB294 \uBAA9\uC7AC\uC640 \uCCA0\uC774 \"1\uAC1C\"\uC529
        \uD544\uC694\uD569\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 7253908412354679478, guid: d785354abee38f84795a0a3d4724df3d, type: 3}
      propertyPath: m_SizeDelta.x
      value: 100
      objectReference: {fileID: 0}
    - target: {fileID: 7253908412354679478, guid: d785354abee38f84795a0a3d4724df3d, type: 3}
      propertyPath: m_SizeDelta.y
      value: 100
      objectReference: {fileID: 0}
    - target: {fileID: 7253908412354679478, guid: d785354abee38f84795a0a3d4724df3d, type: 3}
