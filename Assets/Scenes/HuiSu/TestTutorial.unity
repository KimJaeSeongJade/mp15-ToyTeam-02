    - target: {fileID: 7511797482305428349, guid: d785354abee38f84795a0a3d4724df3d, type: 3}
      propertyPath: m_IsActive
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 7662593255287138388, guid: d785354abee38f84795a0a3d4724df3d, type: 3}
      propertyPath: m_text
      value: "\uC81C\uC791\uCE78\uC5D0\uC11C \uB808\uC77C \uB9CC\uB4DC\uB294 \uAC83\uC744
        \uD655\uC778\uD558\uC167\uB098\uC694?\r\n\uC644\uC131\uB41C \uB808\uC77C\uC740
        \uAC00\uC7A5 \uB9C8\uC9C0\uB9C9 \uCE78\uC778,\n\"\uC81C\uC791\uCE78\"\uC5D0\uC11C
        \uAEBC\uB0BC \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\r\n\uC790 \uC774\uC81C
        \uC5F4\uCC28\uB97C \uC6C0\uC9C1\uC5EC\uBD05\uC2DC\uB2E4!\r\n\n\uC81C\uC791\uCE78\uC5D0\uC11C
        \uC644\uC131\uB41C \uB808\uC77C\uC744 \uAEBC\uB0B4, \n\uC5F4\uCC28\uAC00
        \uCD9C\uBC1C\uD558\uB3C4\uB85D \uC120\uB85C\uB97C \uC774\uC5B4\uC8FC\uC138\uC694!"
      objectReference: {fileID: 0}
