  m_text: "\uB808\uC77C\uC744 \uB9CC\uB4E4\uAE30 \uC704\uD574\uC11C\uB294 '\uBAA9\uC7AC'\uC640
    '\uCCA0'\uC774 \uD544\uC694\uD569\uB2C8\uB2E4.\r\n\r\n\uBAA9\uC7AC: \"\uB3C4\uB07C\"\uB97C
    \uC0AC\uC6A9\uD574 \"\uB098\uBB34\"\uB97C \uCC44\uC9D1\uD558\uBA74 \uC0DD\uC131\r\n\uCCA0:
