    \uB97C \uB20C\uB7EC \uCE90\uB9AD\uD130\uB97C \uC6C0\uC9C1\uC774\uACE0,\r\n\"Shfit\"\uD0A4\uB97C
    \uB204\uB974\uBA74 \uB300\uC2DC\uC774\uB3D9 \uD569\uB2C8\uB2E4.\n\"Space\"\uD0A4\uB97C
    \uB204\uB974\uBA74 \uC8FC\uBCC0 \uBB3C\uCCB4\uC640 \uC0C1\uD638\uC791\uC6A9\uD569\uB2C8\uB2E4.\r\n
