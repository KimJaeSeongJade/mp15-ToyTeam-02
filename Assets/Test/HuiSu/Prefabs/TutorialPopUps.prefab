  m_text: "\"\uC5B8\uB808\uC77C\uB4DC\"\uC758 \uC138\uACC4\uC5D0 \uC624\uC2E0\uAC83\uC744
    \uD658\uC601\uD569\uB2C8\uB2E4!\r\n\uAC8C\uC784\uC758 \uBAA9\uC801\uC740 \n\uC5F4\uCC28\uAC00
    \uC815\uAC70\uC7A5\uAE4C\uC9C0 \uB3C4\uCC29\uD558\uB3C4\uB85D \uB3D5\uB294\uAC83\uC785\uB2C8\uB2E4.\r\n\n\"\uAC71\uC815\uD558\uC9C0
    \uB9C8\uC138\uC694!\"\r\n\uC5F4\uCC28\uB294 \uB808\uC77C\uC744 \uB530\uB77C \uC790\uB3D9\uC73C\uB85C
    \uC6C0\uC9C1\uC785\uB2C8\uB2E4.\r\n\uC6B0\uB9AC\uB294 \uC5F4\uCC28\uAC00 \uC798
    \uC6C0\uC9C1\uC774\uB3C4\uB85D, \n\uADF8\uC800 \"\uB808\uC77C\"\uB9CC \uC124\uCE58\uD558\uBA74
